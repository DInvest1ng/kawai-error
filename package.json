{
  "name": "kawaii-error",
  "displayName": "Kawaii Error",
  "description": "Аниме-девочка в панели реагирует на новые ошибки: «Хозяин, ошибка!»",
  "version": "0.1.0",
  "publisher": "d-istomin",
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "error",
    "fun",
    "anime",
    "notification"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "kawaiiError",
          "title": "Kawaii",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "kawaiiError": [
        {
          "type": "webview",
          "id": "kawaiiError.view",
          "name": "Kawaii"
        }
      ]
    },
    "commands": [
      {
        "command": "kawaiiError.testReaction",
        "title": "Test reaction",
        "category": "Kawaii"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package:bundle",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package:bundle": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.93.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
