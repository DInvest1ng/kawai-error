{
  "name": "kawaii-error",
  "displayName": "Kawaii Error",
  "description": "Аниме-девочка в панели реагирует на новые ошибки: «Хозяин, ошибка!»",
  "version": "0.1.0",
  "publisher": "d-istomin",
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "error",
    "fun",
    "anime",
    "notification"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "kawaiiError",
          "title": "Kawaii",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "kawaiiError": [
        {
          "type": "webview",
          "id": "kawaiiError.view",
          "name": "Kawaii"
        }
      ]
    },
    "commands": [
      {
        "command": "kawaiiError.testReaction",
        "title": "Test reaction",
        "category": "Kawaii"
      }
    ],
    "configuration": {
      "title": "Kawaii Error",
      "properties": {
        "kawaiiError.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Включить реакцию на ошибки."
        },
        "kawaiiError.debounceMs": {
          "type": "number",
          "default": 1500,
          "minimum": 0,
          "description": "Ошибки, пришедшие с интервалом меньше этого (мс), объединяются в одну реакцию."
        },
        "kawaiiError.cooldownSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "Минимальная пауза между реакциями (секунды)."
        },
        "kawaiiError.displayDuration": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "description": "Сколько секунд девочка остаётся на экране."
        },
        "kawaiiError.revealPanel": {
          "type": "boolean",
          "default": true,
          "description": "Показывать панель Kawaii при реакции, если она скрыта."
        },
        "kawaiiError.detectors.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Реагировать на новые ошибки в Problems (диагностики)."
        },
        "kawaiiError.diagnostics.onlyOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Реагировать на ошибки диагностик только после сохранения файла."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package:bundle",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package:bundle": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.93.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
